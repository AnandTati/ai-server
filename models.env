# =============================================================================
# AI Stack Configuration
# =============================================================================
#
# This is the SINGLE SOURCE OF TRUTH for model configuration.
# Edit this file to change models, then restart:
#   docker compose down && docker compose up -d
#
# To update to new models:
#   1. Edit model names below
#   2. Run: docker exec ollama ollama pull <new-model>
#   3. Restart: docker compose restart router
#
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Models
# -----------------------------------------------------------------------------
# CODING_MODEL: Used for code generation, debugging, programming tasks
# Recommended: qwen2.5-coder:14b, deepseek-coder-v2:16b, codellama:13b
CODING_MODEL=qwen2.5-coder:14b

# GENERAL_MODEL: Used for general chat, summarization, reasoning
# Recommended: qwen2.5:14b, llama3.1:8b, mistral:7b
GENERAL_MODEL=qwen2.5:14b

# EMBEDDING_MODEL: Used for FAISS memory semantic search (768 dimensions)
# Recommended: nomic-embed-text (small, fast, good quality)
EMBEDDING_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# Service URLs (internal docker network - usually no need to change)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
SEARXNG_URL=http://searxng:8080
